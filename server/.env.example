# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unruffled_feathers

# Server
PORT=5000
# Comma-separated list of allowed frontend origins.
# In Render, set CLIENT_ORIGIN to include the deployed Vercel URL, e.g.
# CLIENT_ORIGIN=https://www.unruffledfeathers.com,https://unruffled-feathers.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Outgoing email notification for new Contact Us submissions (optional).
# Leave SMTP_HOST empty to disable email and only save submissions to PostgreSQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address the notification email is sent FROM
SMTP_FROM="Unruffled Feathers Website <no-reply@unruffledfeathers.com>"
# Address the notification email is sent TO (your inbox)
CONTACT_NOTIFY_EMAIL=
